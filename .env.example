# Copie para .env e ajuste. Tudo é opcional; vazio = padrão.

# Porta no host e dono dos arquivos em ./data (só para o docker-compose)
FAREJADOR_PORTA=8765
FAREJADOR_UID=1000
FAREJADOR_GID=1000

# Respeito ao YouTube
FAREJADOR_PAUSA=2.5
FAREJADOR_CACHE_HORAS=168

# Descoberta
FAREJADOR_MAX_BUSCAS=8
FAREJADOR_DETALHES_VIDEOS=30
FAREJADOR_MAX_PLAYLISTS=6
FAREJADOR_IDIOMA=pt
FAREJADOR_IGNORAR_TERMOS=

# LLM local opcional (LM Studio). Vazio = desligado.
FAREJADOR_LLM_URL=
# FAREJADOR_LLM_URL=http://192.168.0.6:1234
FAREJADOR_LLM_MODEL=
# FAREJADOR_LLM_MODEL=google/gemma-4-e4b
FAREJADOR_LLM_TIMEOUT=60
FAREJADOR_LLM_NOTA_MIN=0

# MeTube opcional. Vazio = desligado.
#   assinar: /subscribe, o MeTube baixa só os vídeos novos do canal (recomendado)
#   baixar:  /add com no máximo FAREJADOR_METUBE_LIMITE vídeos (sem limite, o MeTube baixaria o canal inteiro)
FAREJADOR_METUBE_URL=
FAREJADOR_METUBE_MODO=assinar
FAREJADOR_METUBE_QUALIDADE=best
FAREJADOR_METUBE_LIMITE=5
FAREJADOR_METUBE_INTERVALO=0
